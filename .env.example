# =============================================================================
# EXCALISTREAM CONFIGURATION
# =============================================================================

# Node.js Control Plane & JSON Streaming Server
PORT=3001
HOST=0.0.0.0

# =============================================================================
# Local to remote
# =============================================================================

# Remote or custom backend URL for Vite dev proxy:
# VITE_BACKEND_URL=http://51.21.14.17:3001

# Explicit WebSocket URL override for the frontend:
# If left commented out, the frontend automatically connects to the host serving the page.
# Set this if you run Vite locally (npm run dev) but want to connect directly to a remote server.
# VITE_WS_URL=ws://51.21.14.17:3001/ws


# =============================================================================
# Audio streaming
# =============================================================================


# Rust WebRTC SFU Configuration
# Port for WebSocket signaling (default 3088)
SFU_SIGNALING_PORT=3088
SFU_SIGNALING_HOST=0.0.0.0

# UDP Media Transport (SRTP/RTCP/STUN)
SFU_UDP_PORT=40000
SFU_UDP_BIND_HOST=0.0.0.0

# Public or LAN IP advertised in ICE candidates to connecting browsers
# For local development, 127.0.0.1 is standard. For LAN/Cloud, set your reachable IP.
SFU_PUBLIC_IP=127.0.0.1

# Optional Frontend Overrides
# VITE_BACKEND_URL=http://localhost:3001
# VITE_WS_URL=ws://localhost:3001/ws
# VITE_SFU_WS_URL=ws://localhost:3088
